# Go build products. The Go tree builds with `go build ./...`; nothing it
# produces belongs in git.
/dlmud
/dlctl
/out/
*.test
*.out
coverage.txt

# --- reference/moderncserver: the C server -------------------------------
# Build artifacts of the C tree. Everything in its bin/ except the docs is a
# compiled product; rebuild with `make` (see reference/moderncserver/README.md).
reference/moderncserver/bin/*
!reference/moderncserver/bin/README
!reference/moderncserver/bin/.cvsignore
reference/moderncserver/src/*.o
reference/moderncserver/src/circle
# Note src/.accepted is deliberately *tracked*: it records that the CircleMUD
# license was accepted, and `make all` depends on it. Without it, the build
# runs ./licheck, which waits for a keypress and would hang CI.

# autoconf-generated / regenerated by ./configure
config.cache
config.log
config.status
reference/moderncserver/config.cache
reference/moderncserver/config.log
reference/moderncserver/config.status
reference/moderncserver/src/conf.h

# runtime-generated logs (the dir is kept via .gitkeep)
syslog
syslog.CRASH
reference/moderncserver/log/*
!reference/moderncserver/log/.gitkeep

# --- data/: runtime game data --------------------------------------------
# Player data - deliberately never committed (real ex-players' password
# hashes, private in-game mail, connection hosts, house contents). None of
# this needs to exist for a fresh boot: db.c's build_player_index()
# auto-creates an empty data/etc/players via touch() if it's missing, and
# db.c's "if this is our first player --- he be God" (~line 2705-2714)
# promotes whoever registers first to LVL_IMPL automatically - a blank
# data/etc/players is the *normal* fresh-install state, not a broken one.
# See docs/investigations/history.md and TODO.md for how to bring real player
# data back in locally without it ever touching git.
data/etc/players
data/etc/players.beforewipe
data/etc/plrmail
data/etc/plrmail.beforwipe
data/pfiles/
data/plralias/*
!data/plralias/.gitkeep
data/plrobjs/*
!data/plrobjs/.gitkeep
data/house/*
!data/house/README
!data/house/.gitkeep
data/.acme/

# editor/OS cruft
*~
.DS_Store
