# Go build products. The Go tree builds with `go build ./...`; nothing it
# produces belongs in git.
/dlmud
/dlctl
/out/
# scripts/build-dist.sh's default output directory -- the cross-compiled
# release archives. `make dist` puts them under out/ instead; this covers
# running the script by hand, and release.yml, which uses the default.
/dist/
*.test
*.out
coverage.txt

# --- reference/moderncserver: the C server -------------------------------
# Build artifacts of the C tree. Everything in its bin/ except the docs is a
# compiled product; rebuild with `make` (see reference/moderncserver/README.md).
reference/moderncserver/bin/*
!reference/moderncserver/bin/README
!reference/moderncserver/bin/.cvsignore
reference/moderncserver/src/*.o
reference/moderncserver/src/circle
# Note src/.accepted is deliberately *tracked*: it records that the CircleMUD
# license was accepted, and `make all` depends on it. Without it, the build
# runs ./licheck, which waits for a keypress and would hang CI.

# autoconf-generated / regenerated by ./configure
config.cache
config.log
config.status
reference/moderncserver/config.cache
reference/moderncserver/config.log
reference/moderncserver/config.status
reference/moderncserver/src/conf.h

# runtime-generated logs (the dir is kept via .gitkeep)
syslog
syslog.CRASH
reference/moderncserver/log/*
!reference/moderncserver/log/.gitkeep

# --- examples/stock/binary/: the default --lib-dir ------------------------
# examples/stock/binary/ is a checked-in, static example (stock CircleMUD's
# own lib/), but it is also the server's default --lib-dir (internal/config/
# config.go): running dlmud with no flags at all boots against it, and a
# fresh boot writes runtime state into whatever --lib-dir is. None of that
# runtime state belongs in git, the same reasoning the old data/'s rules had
# from when *that* was the default (db.c's build_player_index()
# auto-creates an empty etc/players via touch() if it's missing, and db.c's
# "if this is our first player --- he be God" (~line 2705-2714) promotes
# whoever registers first to LVL_IMPL automatically - a blank etc/players is
# the *normal* fresh-boot state, not a broken one).
examples/stock/binary/etc/players
examples/stock/binary/etc/players.beforewipe
examples/stock/binary/etc/plrmail
examples/stock/binary/etc/plrmail.beforwipe
examples/stock/binary/pfiles/
examples/stock/binary/plralias/*
!examples/stock/binary/plralias/.gitkeep
examples/stock/binary/plrobjs/*
!examples/stock/binary/plrobjs/.gitkeep
examples/stock/binary/house/*
!examples/stock/binary/house/README
!examples/stock/binary/house/.gitkeep
examples/stock/binary/.acme/

# examples/stock/yaml/ is not the default --lib-dir, so reaching it needs an
# explicit --lib-dir/--player-format flag, but the same runtime-state
# protection still applies if someone points a demo server at it.
examples/stock/yaml/pfiles/
examples/stock/yaml/players/
examples/stock/yaml/.acme/

# examples/mini/ is the tutorial world. test/play copies it to a temp directory
# rather than running it in place, but examples/mini/README.md documents running
# it in place too, and that writes the same runtime state anywhere else does.
examples/mini/binary/etc/players
examples/mini/binary/etc/plrmail
examples/mini/binary/pfiles/
examples/mini/binary/plralias/
examples/mini/binary/plrobjs/
examples/mini/binary/house/
examples/mini/yaml/pfiles/
examples/mini/yaml/players/

# data/ was the default --lib-dir before examples/stock/binary/ took over
# (see that section's own comment above); it is not checked in and not the
# default any more, but a --lib-dir=data server run locally still leaves
# the same runtime state behind.
data/pfiles/

# NOT ignored, deliberately: etc/time, the mud clock's epoch
# (internal/persist/clock, ClassicFile = "time"). It looks like exactly the
# runtime state the rules above cover, and hiding it would be worse than the
# untracked file it leaves behind, because `dlctl import` *reads* it: run
# the server in place once and a regenerated examples/stock/yaml gets a
# different state/clock.yaml, which the release-time "example worlds must match
# dlctl import's output" check then fails on. scripts/release.sh does not stop
# there -- it regenerates and commits -- so a silent etc/time would get a
# drifted clock committed rather than caught. Leaving it in `git status` is
# what makes it a thing you notice and delete.

# act (`make ci`) reads secrets and variables from these by default. .actrc
# itself is tracked -- it holds the runner image and nothing sensitive -- but
# a .secrets file exists to hold a real GITHUB_TOKEN, so it must never be
# committable. See docs/developer.md.
.secrets
.vars
.env.act

# editor/OS cruft
*~
.DS_Store
.claude/worktrees/
