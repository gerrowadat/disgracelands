# build artifacts - everything in bin/ except the docs is a compiled
# product of src/, rebuild with `make` (see BUILDING.md)
bin/*
!bin/README
!bin/.cvsignore
src/*.o
src/circle

# autoconf-generated / regenerated by ./configure
config.cache
config.log
config.status
src/conf.h

# runtime-generated logs (kept as an empty dir via log/.gitkeep)
syslog
syslog.CRASH
log/*
!log/.gitkeep

# Player data - deliberately never committed (real ex-players' password
# hashes, private in-game mail, connection hosts, house contents). None
# of this needs to exist for a fresh boot: db.c's build_player_index()
# auto-creates an empty lib/etc/players via touch() if it's missing, and
# db.c's "if this is our first player --- he be God" (~line 2705-2714)
# promotes whoever registers first to LVL_IMPL automatically - a blank
# lib/etc/players is the *normal* fresh-install state, not a broken one.
# See docs/history.md and TODO.md for how to bring real player data back
# in locally (from the archive, or from lib/pfiles produced by
# src/util/bin2ascii.c) without it ever touching git.
lib/etc/players
lib/etc/players.beforewipe
lib/etc/plrmail
lib/etc/plrmail.beforwipe
lib/pfiles/
lib/plralias/*
!lib/plralias/.gitkeep
lib/plrobjs/*
!lib/plrobjs/.gitkeep
lib/house/*
!lib/house/README
!lib/house/.gitkeep

# editor/OS cruft
*~
.DS_Store
